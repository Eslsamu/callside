{
  "name": "callside",
  "version": "0.7.0",
  "description": "Open-source live call assistance without typing. Contextual suggestions, transcription, and global shortcuts.",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "local:speakers:setup": "node scripts/local-speakers-setup.mjs",
    "dev": "tsx server/index.ts",
    "local:test": "tsx server/local-test.ts",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/server/index.js",
    "desktop": "npm run build && electron .",
    "desktop:pack": "npm run desktop:runtimes && npm run build && electron-builder --dir --publish never --config.directories.output=.local/desktop-preview",
    "desktop:dist": "node scripts/build-release.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run build && npm test && npm run test:e2e",
    "test:desktop": "npm run build && node tests/desktop-smoke.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "local:compare": "tsx server/local-compare.ts",
    "local:setup": "node scripts/cohere-setup.mjs",
    "desktop:runtimes": "node scripts/desktop-runtimes.mjs",
    "desktop:release": "node scripts/build-release.mjs --public",
    "desktop:windows-preview": "node scripts/windows-preview.mjs",
    "desktop:community": "node scripts/build-release.mjs --community"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "dotenv": "^17.2.3",
    "electron-updater": "^6.8.9",
    "express": "^5.1.0",
    "jose": "^6.2.12",
    "lucide-react": "^0.468.0",
    "onnxruntime-web": "1.30.0",
    "openai": "^6.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.18.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.0.12",
    "prettier": "^3.9.9",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "org.callside.app",
    "productName": "Callside",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "asarUnpack": [
      "desktop/bin/**/*"
    ],
    "afterAllArtifactBuild": "./scripts/release-links.mjs",
    "files": [
      "dist/**/*",
      "dist-server/**/*",
      "desktop/**/*",
      "package.json",
      "LICENSE"
    ],
    "directories": {
      "output": "release/v${version}"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Callside transcribes your microphone during calls you start.",
        "NSAudioCaptureUsageDescription": "Callside transcribes call audio from your computer.",
        "NSScreenCaptureUsageDescription": "Callside captures shared audio during calls you start."
      },
      "entitlements": "desktop/entitlements.mac.plist",
      "entitlementsInherit": "desktop/entitlements.mac.plist",
      "minimumSystemVersion": "14.0",
      "signIgnore": [
        "\\.pak$"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "executableName": "org.callside.app"
    },
    "icon": "desktop/icon.png",
    "publish": [
      {
        "provider": "github",
        "owner": "Eslsamu",
        "repo": "callside",
        "releaseType": "release"
      }
    ],
    "dmg": {
      "title": "Callside ${version}",
      "contents": [
        {
          "x": 140,
          "y": 180
        },
        {
          "x": 420,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 560,
        "height": 360
      }
    }
  },
  "author": "Callside contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eslsamu/callside.git"
  },
  "homepage": "https://github.com/Eslsamu/callside#readme",
  "bugs": {
    "url": "https://github.com/Eslsamu/callside/issues"
  },
  "keywords": [
    "cluely-alternative",
    "open-source",
    "meeting-assistant",
    "live-transcription",
    "call-copilot",
    "ai-assistant",
    "electron",
    "openai",
    "workshop",
    "sales-assistant"
  ]
}
